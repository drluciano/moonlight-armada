From d3e220c78e586dec3e3db2f48f83721cda317762 Mon Sep 17 00:00:00 2001
From: Moonlight Armada <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 01:57:11 +0000
Subject: [PATCH 2/2] media: qcom: iris: clock low latency decoding for
 latency, not throughput

The decoder clock is scaled to the input frame rate measured over the
last second, and the DDR bandwidth vote always assumes 30 fps. Both are
sized to just keep up with the stream, so each frame takes about one
frame interval to decode. On SM8650 with a 1080p H.264 game stream this
was measured at 8.6 ms per frame at 120 fps and 16 ms at 60 fps, while
the same stream decodes in under 1 ms when other load happens to keep
the clocks up.

When a client asks for low latency decoding (display delay enabled with
a delay of 0), keep the instance frame rate at the maximum so the clock
is set for the fastest decode, and vote bandwidth for that rate instead
of the fixed 30 fps. Other clients keep the current power behavior.

Depends on the patch exposing the display delay controls on gen2
decoders. Compile tested only (arm64, W=1).
---
 drivers/media/platform/qcom/iris/iris_ctrls.c | 15 ++++++++++++---
 drivers/media/platform/qcom/iris/iris_ctrls.h |  1 +
 drivers/media/platform/qcom/iris/iris_power.c |  4 +++-
 drivers/media/platform/qcom/iris/iris_vdec.c  |  8 +++++++-
 4 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index 54aacdd8b..1f2e06539 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -521,7 +521,17 @@ int iris_set_u32(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
 
 /*
  * A display delay of 0 means the client wants frames returned as soon as they
- * are decoded, which maps to decode order output in the firmware. Any other
+ * are decoded, i.e. it cares about the latency of each frame rather than only
+ * keeping up with the stream.
+ */
+bool iris_is_low_latency_decode(struct iris_inst *inst)
+{
+	return inst->fw_caps[DISPLAY_DELAY_ENABLE].value &&
+	       !inst->fw_caps[DISPLAY_DELAY].value;
+}
+
+/*
+ * Low latency decoding maps to decode order output in the firmware. Any other
  * delay is left to the firmware's default display order behavior.
  */
 int iris_set_decode_order(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
@@ -530,8 +540,7 @@ int iris_set_decode_order(struct iris_inst *inst, enum platform_inst_fw_cap_type
 	u32 hfi_id = inst->fw_caps[cap_id].hfi_id;
 	u32 hfi_value;
 
-	if (!inst->fw_caps[DISPLAY_DELAY_ENABLE].value ||
-	    inst->fw_caps[DISPLAY_DELAY].value)
+	if (!iris_is_low_latency_decode(inst))
 		return 0;
 
 	hfi_value = 1;
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.h b/drivers/media/platform/qcom/iris/iris_ctrls.h
index fe9b9075f..548224a82 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.h
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.h
@@ -17,6 +17,7 @@ int iris_set_u32_enum(struct iris_inst *inst, enum platform_inst_fw_cap_type cap
 int iris_set_stage(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_pipe(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_u32(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
+bool iris_is_low_latency_decode(struct iris_inst *inst);
 int iris_set_decode_order(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_profile(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_level(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
diff --git a/drivers/media/platform/qcom/iris/iris_power.c b/drivers/media/platform/qcom/iris/iris_power.c
index 91aa21d40..d911412a5 100644
--- a/drivers/media/platform/qcom/iris/iris_power.c
+++ b/drivers/media/platform/qcom/iris/iris_power.c
@@ -8,6 +8,7 @@
 #include <media/v4l2-mem2mem.h>
 
 #include "iris_buffer.h"
+#include "iris_ctrls.h"
 #include "iris_instance.h"
 #include "iris_power.h"
 #include "iris_resources.h"
@@ -68,7 +69,8 @@ static int iris_vote_interconnects(struct iris_inst *inst)
 
 	vote_data->width = inp_f->fmt.pix_mp.width;
 	vote_data->height = inp_f->fmt.pix_mp.height;
-	vote_data->fps = DEFAULT_FPS;
+	/* Low latency decoding needs bandwidth for the clock it runs at, see iris_vdec_qbuf() */
+	vote_data->fps = iris_is_low_latency_decode(inst) ? inst->frame_rate : DEFAULT_FPS;
 
 	inst->power.icc_bw = iris_calc_bw(inst, vote_data);
 
diff --git a/drivers/media/platform/qcom/iris/iris_vdec.c b/drivers/media/platform/qcom/iris/iris_vdec.c
index 9e228b704..6360776f1 100644
--- a/drivers/media/platform/qcom/iris/iris_vdec.c
+++ b/drivers/media/platform/qcom/iris/iris_vdec.c
@@ -445,7 +445,13 @@ int iris_vdec_qbuf(struct iris_inst *inst, struct vb2_v4l2_buffer *vbuf)
 		return 0;
 	}
 
-	if (buf->type == BUF_INPUT) {
+	/*
+	 * The clock is normally scaled to the measured input frame rate, which is
+	 * just fast enough to keep up: each frame then takes about one frame
+	 * interval to decode. Low latency clients need each frame back as soon as
+	 * possible, so keep the frame rate at the maximum for them instead.
+	 */
+	if (buf->type == BUF_INPUT && !iris_is_low_latency_decode(inst)) {
 		cur_buf_ns = ktime_get_ns();
 
 		if (!inst->frame_counter)
-- 
