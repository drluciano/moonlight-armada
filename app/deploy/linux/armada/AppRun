#!/bin/sh
# Remember what Steam passed us (see below) before clearing it
INHERITED_LD_PRELOAD="$LD_PRELOAD"
INHERITED_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
unset LD_PRELOAD LD_LIBRARY_PATH

HERE="$(dirname "$(readlink -f "$0")")"

LOGDIR="${XDG_CACHE_HOME:-$HOME/.cache}/moonlight-armada"
mkdir -p "$LOGDIR" 2>/dev/null
LOG="$LOGDIR/last-run.log"

# Keep a log of every run, including dynamic loader failures
{
  echo "=== $(date) ==="
  echo "XDG_SESSION_TYPE=$XDG_SESSION_TYPE WAYLAND_DISPLAY=$WAYLAND_DISPLAY DISPLAY=$DISPLAY"
  echo "SteamGameId=$SteamGameId"
  echo "Inherited LD_PRELOAD=$INHERITED_LD_PRELOAD"
  echo "Inherited LD_LIBRARY_PATH=$INHERITED_LD_LIBRARY_PATH"
} > "$LOG" 2>/dev/null

# Steam launches non-Steam games with its own runtime on LD_LIBRARY_PATH and
# its overlay in LD_PRELOAD. Neither is meant for this app, and the runtime
# libraries can shadow the system ones we depend on, so start clean.
export LD_LIBRARY_PATH="$HERE/usr/lib"
export QT_PLUGIN_PATH="$HERE/usr/plugins"
export QML_IMPORT_PATH="$HERE/usr/qml"
export QML2_IMPORT_PATH="$HERE/usr/qml"

# Prefer the host libva (it must match the host's VA drivers); fall back to ours if absent
if ! ldconfig -p 2>/dev/null | grep -q 'libva\.so\.2 '; then
  export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$HERE/opt/libva-fallback"
fi

{
  "$HERE/usr/bin/moonlight" "$@" 2>&1
  rc=$?
  echo "=== exit code $rc ==="
  if [ $rc -eq 127 ]; then
    echo "Missing libraries:"
    for f in "$HERE/usr/bin/moonlight" $(find "$HERE/usr" -name '*.so*' -type f); do
      ldd "$f" 2>/dev/null | grep "not found" | sed "s|^|  $(basename "$f"): |"
    done | sort -u
  fi
} | tee -a "$LOG"
